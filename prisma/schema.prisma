// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  trashedAt DateTime?
  id        String   @id @default(cuid())
  name      String
  customer  String?
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  racks     Rack[]
}

model Rack {
  trashedAt DateTime?
  id        String   @id @default(cuid())
  name      String
  heightRU  Int      @default(42)
  configuration Json @default("{}")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  devices   DeviceInstance[]
  history   RackHistory?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RackHistory {
  rackId    String @id
  rack      Rack @relation(fields: [rackId], references: [id], onDelete: Cascade)
  snapshots Json
  cursor    Int @default(0)
}

model CatalogDevice {
  id        String   @id @default(cuid())
  sku       String   @unique
  vendor    String
  model     String
  heightRU  Int      @default(1)
  category  String?
  createdAt DateTime @default(now())
  rawData   Json?
  instances DeviceInstance[]
}

model DeviceInstance {
  id              String   @id @default(cuid())
  label           String?
  startRU         Int
  mounting        String   @default("front")
  details         Json     @default("{}")
  rackId          String
  rack            Rack          @relation(fields: [rackId], references: [id], onDelete: Cascade)
  catalogDeviceId String
  catalogDevice   CatalogDevice @relation(fields: [catalogDeviceId], references: [id])
  connectionsFrom Connection[]  @relation("FromDevice")
  connectionsTo   Connection[]  @relation("ToDevice")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Connection {
  lengthValue Float?
  lengthUnit String?
  id           String   @id @default(cuid())
  cableType    String?
  label        String?
  fromPort     String?
  toPort       String?
  fromDeviceId String
  toDeviceId   String?
  external     Json?
  fromDevice   DeviceInstance @relation("FromDevice", fields: [fromDeviceId], references: [id], onDelete: Cascade)
  toDevice     DeviceInstance? @relation("ToDevice", fields: [toDeviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}
